# NOTE : ces règles pointent vers /404.html, qui DOIT exister à la racine.
# Cloudflare Pages sert aussi automatiquement 404.html (avec le statut 404)
# pour toute route qui ne correspond à aucun fichier.

# Favicon : les navigateurs/crawlers demandent /favicon.ico par défaut
/favicon.ico            /favicon.svg  200

# Sensitive files — return 404
/.env                   /404.html  404
/.env.*                 /404.html  404
/config.json            /404.html  404
/config.js              /404.html  404
/settings.json          /404.html  404

# Git internals
/.git/*                 /404.html  404
/.gitignore             /404.html  404
/.github/*              /404.html  404

# Package files
/package.json           /404.html  404
/package-lock.json      /404.html  404
/node_modules/*         /404.html  404

# OS artifacts
/.DS_Store              /404.html  404
/Thumbs.db              /404.html  404

# Backup / temp / log files
/*.bak                  /404.html  404
/*.backup               /404.html  404
/*.old                  /404.html  404
/*.tmp                  /404.html  404
/*.log                  /404.html  404
/*.sql                  /404.html  404

# Common attack paths
/admin                  /404.html  404
/admin/*                /404.html  404
/wp-admin/*             /404.html  404
/wp-login.php           /404.html  404
/phpmyadmin/*           /404.html  404
